# Copie para .env e preencha. O arquivo .env NÃO vai para o Git.
# Os nomes de modelo abaixo são exemplos: confira o nome atual na documentação de cada provedor.

# "llm" usa um modelo de linguagem; "regex" roda sem IA (sem custo, sem chave)
IA_PROVEDOR=llm

# ---- Opção 1: OpenAI (pago, centavos por centenas de vistorias com gpt-4o-mini) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODELO=gpt-4o-mini
LLM_API_KEY=sk-...

# ---- Opção 2: Google Gemini (tem camada gratuita) ----
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODELO=gemini-2.0-flash
# LLM_API_KEY=...

# ---- Opção 3: Groq (camada gratuita, modelos abertos) ----
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODELO=llama-3.1-8b-instant
# LLM_API_KEY=gsk_...

# ---- Opção 4: Ollama local (gratuito, roda na sua máquina) ----
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODELO=llama3.1
# LLM_API_KEY=

# true = envia a foto junto (modelo multimodal: gpt-4o-mini, gemini-2.0-flash...)
LLM_ENVIAR_IMAGEM=false

# Data fixa para a demonstração (deixe vazio para usar a data de hoje)
DATA_REFERENCIA=
